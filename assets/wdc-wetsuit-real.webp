.whaledive-home .wd-course-grid .wd-course-body h3,
.whaledive-home #equipment .wd-home-equip-body h3,
.whaledive-home #equipment .wd-equip-home-body h3{margin:0 0 2px!important;min-height:0!important;line-height:1.08!important}
