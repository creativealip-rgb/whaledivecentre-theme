  .whaledive-home .wd-section .wd-sub,.whaledive-home .wd-section p,.whaledive-home .wd-footer p{width:100%!important;max-width:100%!important;white-space:normal!important;overflow-wrap:break-word!important;margin-left:0!important;margin-right:0!important}
  .whaledive-home .wd-checks,.whaledive-home .wd-logos,.whaledive-home .wd-course-slider,.whaledive-home .wd-course-grid,.whaledive-home .wd-equipment-grid,.whaledive-home .wd-reviews-grid,.whaledive-home .wd-article-grid,.whaledive-home .wd-trust-row,.whaledive-home .wd-footer-top{display:grid!important;width:100%!important;max-width:100%!important;margin-left:0!important;margin-right:0!important;grid-template-columns:1fr!important;gap:16px!important;justify-items:stretch!important;align-items:stretch!important}
  .whaledive-home .wd-check,.whaledive-home .wd-course-card,.whaledive-home .wd-home-equip-card,.whaledive-home .wd-equip-card,.whaledive-home .wd-review-card,.whaledive-home .wd-featured-card,.whaledive-home .wd-mini-article,.whaledive-home .wd-trust-row>div,.whaledive-home .wd-footer-col,.whaledive-home .wd-footer-brand{display:flex!important;flex-direction:column!important;width:100%!important;max-width:100%!important;min-width:0!important;margin-left:0!important;margin-right:0!important;box-sizing:border-box!important}.wd-hidden,.whaledive-home .wd-hidden{display:none!important;visibility:hidden!important;height:0!important;overflow:hidden!important;position:absolute!important;left:-9999px!important}
.whaledive-home .wd-course-affiliations .wd-logo-pill{width:auto!important;max-width:none!important;flex-direction:row!important;gap:6px!important}
  .whaledive-home .wd-check,.whaledive-home .wd-logo-pill,.whaledive-home .wd-review-card,.whaledive-home .wd-trust-row>div{display:flex!important;align-items:center!important;justify-content:center!important;text-align:center!important}
  .whaledive-home .wd-section-cta{width:100%!important;max-width:100%!important;margin-left:0!important;margin-right:0!important;padding-left:0!important;padding-right:0!important}
  .whaledive-home #articles .wd-article-head{display:grid!important;grid-template-columns:1fr!important;gap:16px!important;text-align:center!important;align-items:center!important;width:100%!important;max-width:100%!important}
  .whaledive-home #articles .wd-article-head>div{width:100%!important;max-width:100%!important}
  .whaledive-home #articles .wd-article-head .wd-btn,.whaledive-home #membership .wd-btn,.whaledive-home .wd-section-cta .wd-btn,.whaledive-home .wd-footer .wd-btn{width:100%!important;max-width:100%!important;justify-content:center!important;margin-left:0!important;margin-right:0!important;box-sizing:border-box!important}
  .whaledive-home .wd-footer-bottom{display:grid!important;grid-template-columns:1fr!important;gap:10px!important;text-align:center!important;width:100%!important;max-width:100%!important}
}
/* ============================================================
   UIUX normalization pass 2026-05-30 — unify section rhythm + card breathing.
   Supersedes stacked "tightening pass" blocks in style.css.
   ============================================================ */
.whaledive-home .wd-section{padding-top:72px!important;padding-bottom:72px!important}
.whaledive-home #courses.wd-section,
.whaledive-home #equipment.wd-section{padding-top:72px!important;padding-bottom:72px!important}
/* card grid: looser premium gap */
.whaledive-home .wd-course-grid,
.whaledive-home .wd-equipment-grid{gap:22px!important}
/* card inner body: more breathing room */
.whaledive-home .wd-course-body,
.whaledive-home .wd-equip-home-body,
.whaledive-home .wd-home-equip-body,
.whaledive-home #courses .wd-course-body,
.whaledive-home #equipment .wd-home-equip-body{padding:16px!important;gap:6px!important}
/* card media: taller ~16:10 visuals */
.whaledive-home .wd-course-photo,
.whaledive-home .wd-equip-photo,
.whaledive-home .wd-home-equip-photo,
.whaledive-home #courses .wd-course-photo{height:180px!important}
/* card description: 2-line clamp for uniform height */
.whaledive-home .wd-course-body p,
.whaledive-home #courses .wd-course-body p,
.whaledive-home .wd-home-equip-body p{display:-webkit-box!important;-webkit-line-clamp:2!important;-webkit-box-orient:vertical!important;overflow:hidden!important;margin:0 0 8px!important}
/* card CTA arrow: consistent spacing */
.whaledive-home .wd-course-body a,
.whaledive-home #courses .wd-course-body a{letter-spacing:.02em!important;gap:6px!important}
/* card title: relaxed line-height */
.whaledive-home .wd-course-body h3,
.whaledive-home .wd-course-grid .wd-course-body h3,
.whaledive-home .wd-home-equip-body h3,
.whaledive-home .wd-equip-home-body h3,
.whaledive-home #courses .wd-course-body h3,
.whaledive-home #equipment .wd-home-equip-body h3{line-height:1.28!important;margin:0 0 6px!important;min-height:0!important}
/* card link/CTA: slightly larger tap target */
.whaledive-home .wd-course-body a,
.whaledive-home .wd-course-grid .wd-course-body a,
.whaledive-home .wd-home-equip-body a,
.whaledive-home .wd-equip-home-body a,
.whaledive-home #courses .wd-course-body a,
.whaledive-home #equipment .wd-home-equip-body a{font-size:13px!important}
@media(max-width:760px){
  .whaledive-home .wd-section,
  .whaledive-home #courses.wd-section,
  .whaledive-home #equipment.wd-section{padding-top:56px!important;padding-bottom:56px!important}
  .whaledive-home .wd-course-grid,
  .whaledive-home .wd-equipment-grid{gap:16px!important}
  .whaledive-home .wd-course-photo,
  .whaledive-home .wd-equip-photo,
  .whaledive-home .wd-home-equip-photo,
  .whaledive-home #courses .wd-course-photo{height:160px!important}
}
/* UIUX 2026-05-30 — win specificity vs #courses ID-scoped overrides in style.css */
body.whaledive-home #courses .wd-course-grid,
body.whaledive-home #equipment .wd-equipment-grid{gap:22px!important}
body.whaledive-home #courses .wd-course-photo,
body.whaledive-home #equipment .wd-home-equip-photo,
body.whaledive-home #equipment .wd-equip-photo{height:180px!important}
@media(max-width:760px){
  body.whaledive-home #courses .wd-course-grid,
  body.whaledive-home #equipment .wd-equipment-grid{gap:16px!important}
  body.whaledive-home #courses .wd-course-photo,
  body.whaledive-home #equipment .wd-home-equip-photo,
  body.whaledive-home #equipment .wd-equip-photo{height:160px!important}
}
/* Trust bar override — must beat style.css specificity */
.whaledive-home .wd-trust-bar{background:#0a1628!important;padding:56px 0!important;text-align:center!important}
.whaledive-home .wd-trust-bar .wd-shell{max-width:960px!important;margin:0 auto!important}
.whaledive-home .wd-trust-text{color:rgba(255,255,255,.65)!important;font-size:15px!important;line-height:1.65!important;max-width:680px!important;margin:0 auto 28px!important;letter-spacing:.005em!important}
.whaledive-home .wd-trust-label{color:rgba(255,255,255,.35)!important;font-size:11px!important;font-weight:800!important;letter-spacing:.14em!important;text-transform:uppercase!important;margin-bottom:22px!important}
.whaledive-home .wd-trust-logos{display:flex!important;flex-direction:column!important;align-items:center!important;gap:14px!important;max-width:880px!important;margin:0 auto!important}
.whaledive-home .wd-trust-row{display:flex!important;flex-wrap:wrap!important;justify-content:center!important;align-items:center!important;gap:12px!important;margin:0!important}
.whaledive-home .wd-trust-row img{height:auto!important;max-height:36px!important;width:auto!important;object-fit:contain!important;filter:none!important;opacity:1!important;background:#fff!important;border-radius:8px!important;padding:6px 10px!important;box-sizing:content-box!important;transition:transform .25s ease,box-shadow .25s ease!important}
.whaledive-home .wd-trust-row img:hover{transform:scale(1.05)!important;box-shadow:0 4px 16px rgba(0,0,0,.3)!important}
.whaledive-home .wd-trust-row-5{gap:10px!important}
.whaledive-home .wd-trust-row-5 img{max-height:28px!important;padding:5px 8px!important}
@media(max-width:760px){
  .whaledive-home .wd-trust-bar{padding:40px 0!important}
  .whaledive-home .wd-trust-text{font-size:14px!important;margin-bottom:22px!important}
  .whaledive-home .wd-trust-row{gap:10px!important}
  .whaledive-home .wd-trust-row img{max-height:28px!important;padding:5px 8px!important;border-radius:6px!important}
  .whaledive-home .wd-trust-row-5{gap:8px!important}
  .whaledive-home .wd-trust-row-5 img{max-height:22px!important;padding:4px 6px!important}
}
</style></head>
<body class="error404 wp-theme-theme-travel-master whaledive-home wdc-current-font-mode"><main class="wd-page">
  <header class="wd-header"><meta charset="utf-8"><div class="wd-shell"><div class="wd-nav"><a class="wd-brand" href="https://whaledivecentre.com/"><img class="wd-brand-logo" src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-navbar-logo.jpg?v=20260514b" alt="Whale Dive Centre"><span>Whale Dive Centre</span></a><button class="wd-hamburger" type="button" aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button><nav class="wd-menu" id="wd-mobile-menu"><a href="https://whaledivecentre.com/" data-nav="home">Beranda</a><a href="https://whaledivecentre.com/courses/" data-nav="courses">Kursus</a><a href="https://whaledivecentre.com/equipment/" data-nav="equipment">Peralatan</a><a href="https://whaledivecentre.com/about/" data-nav="about">Tentang</a><a href="https://whaledivecentre.com/blog/" data-nav="blog">Blog</a><div class="gt-lang-switcher wd-lang-switcher" aria-label="Language switcher"><a href="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-wetsuit-real.webp" class="gt-lang-link is-active" hreflang="id-ID">ID</a><a href="https://whaledivecentre.com/en/wp-content/themes/theme-travel-master/assets/wdc-wetsuit-real.webp" class="gt-lang-link" hreflang="en-US">EN</a></div><a href="https://whaledivecentre.com/member-login/" class="wd-nav-member">Masuk</a></nav></div></div></header>
  <!-- HERO -->
  <section class="wd-hero wd-hero-simple"><div class="wd-shell wd-hero-focus"><div class="wd-hero-copy"><span class="wd-kicker">Latihan selam Jakarta &amp; komunitas diving</span><h1>Mulai Tenang.<br>Dive Pede.</h1><p>Belajar, siapkan gear, dan rencanakan petualangan bawah air berikutnya bersama crew yang menjaga setiap dive tetap jelas, aman, dan peduli laut.</p><div class="wd-actions"><a class="wd-btn" href="/courses/">Lihat Kursus</a><a class="wd-btn alt" href="/contact/">Tanya Crew</a></div><div class="wd-hero-proof"><span><b>Bersertifikat</b> dipandu instruktur</span><span><b>Grup kecil</b> progres skill lebih tenang</span><span><b>Rekreasional</b> jalur dive santai</span></div></div><aside class="wd-hero-card" aria-label="Dive centre highlights"><span>Intake berikutnya</span><strong>Open Water</strong><p>Kelas grup kecil, fitting gear, dan bimbingan instruktur yang tenang dari kolam ke laut.</p><a href="/courses/">Lihat jalur</a></aside></div></section>
  <!-- WELCOME / TRUST BAR -->
  <section class="wd-trust-bar"><div class="wd-shell"><p class="wd-trust-text">Gerbang kamu ke dunia bawah laut. Kami menggabungkan pelatihan selam profesional, peralatan berkualitas, bimbingan grup kecil, dan semangat konservasi laut.</p><div class="wd-trust-label">Dipercaya oleh</div><div class="wd-trust-logos" aria-label="Dive training and equipment partners"><div class="wd-trust-row"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/partners/naui.webp" alt="NAUI" loading="lazy" decoding="async"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/partners/tdi.webp" alt="TDI" loading="lazy" decoding="async"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/partners/dan.webp" alt="DAN" loading="lazy" decoding="async"></div><div class="wd-trust-row wd-trust-row-5"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/partners/sherwood.webp" alt="Sherwood Scuba" loading="lazy" decoding="async"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/partners/zeagle.webp" alt="Zeagle" loading="lazy" decoding="async"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/partners/waterproof.webp" alt="Waterproof" loading="lazy" decoding="async"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/partners/shearwater.webp" alt="Shearwater Research" loading="lazy" decoding="async"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/partners/bare.webp" alt="BARE" loading="lazy" decoding="async"></div></div></div></section>

  <!-- FOCUS AREAS (moved from /about) -->
  <section class="wd-section wd-dark wd-center"><div class="wd-shell"><span class="wd-kicker">Fokus Kami</span><h2 class="wd-title">Dari dive pertama sampai level profesional.</h2><div class="wd-safety-grid"><article><b>Pelatihan rekreasional</b><span>Membangun fondasi skill, buoyancy, buddy awareness, dan kepercayaan diri untuk diver baru.</span></article><article><b>Pelatihan profesional</b><span>Mengembangkan leadership, briefing, rescue awareness, dan standar kerja profesional.</span></article><article><b>Budaya teknis &amp; keselamatan</b><span>Mendorong perencanaan konservatif, disiplin prosedur, dan keputusan yang sadar risiko.</span></article></div></div></section>

  <!-- COURSES -->
  <section id="courses" class="wd-section wd-dark wd-center"><div class="wd-shell"><div class="wd-divider"><h2 class="wd-title">Kursus Selam Kami</h2></div><p class="wd-sub" style="margin-bottom:28px!important;">Jalur terstruktur dari napas pertama di bawah air hingga kepemimpinan dive profesional.</p><div class="wd-filter-bar" aria-label="Course category tabs" style="margin-bottom:36px!important;">
<button class="wd-chip active" data-tab="naui" onclick="wdSwitchTab('naui')">NAUI</button>
<button class="wd-chip" data-tab="tdi" onclick="wdSwitchTab('tdi')">TDI</button>
</div>
<div class="wd-course-grid" id="wd-tab-naui" style="width:100%!important;min-width:0!important;max-width:100%!important;margin:0!important;display:grid!important;grid-auto-flow:row!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:22px!important;">
<article class="wd-course-card"><div class="wd-course-photo" style="background-image:linear-gradient(135deg,rgba(232,251,255,.28),rgba(255,255,255,.42)),url('https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-course-open-water-real.png')!important;background-size:cover,contain!important;background-position:center!important;background-repeat:no-repeat!important;"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-course-open-water-real.png" alt="Open Water Scuba Diver" loading="eager" decoding="async"></div><div class="wd-course-body"><div class="wd-course-meta"><span>Pemula</span><span>3-4 hari</span></div><h3>Open Water Scuba Diver</h3><p>Sertifikasi pertama untuk dive aman bersama buddy.</p><a href="/courses/">Lihat Detail →</a></div></article><article class="wd-course-card"><div class="wd-course-photo" style="background-image:linear-gradient(135deg,rgba(232,251,255,.28),rgba(255,255,255,.42)),url('https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-course-advanced-open-water-real.png')!important;background-size:cover,contain!important;background-position:center!important;background-repeat:no-repeat!important;"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-course-advanced-open-water-real.png" alt="Advanced Open Water Diver" loading="eager" decoding="async"></div><div class="wd-course-body"><div class="wd-course-meta"><span>Level lanjut</span><span>2-3 hari</span></div><h3>Advanced Open Water Diver</h3><p>Kembangkan skill dengan dive lebih dalam, navigasi, dan pengalaman khusus.</p><a href="/courses/">Lihat Detail →</a></div></article><article class="wd-course-card"><div class="wd-course-photo" style="background-image:linear-gradient(135deg,rgba(232,251,255,.28),rgba(255,255,255,.42)),url('https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-course-rescue-diver-real.png')!important;background-size:cover,contain!important;background-position:center!important;background-repeat:no-repeat!important;"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-course-rescue-diver-real.png" alt="Rescue Scuba Diver" loading="eager" decoding="async"></div><div class="wd-course-body"><div class="wd-course-meta"><span>Keselamatan</span><span>2-3 hari</span></div><h3>Rescue Scuba Diver</h3><p>Pelajari pencegahan dan penanganan darurat selam.</p><a href="/courses/">Lihat Detail →</a></div></article><article class="wd-course-card"><div class="wd-course-photo" style="background-image:linear-gradient(135deg,rgba(232,251,255,.28),rgba(255,255,255,.42)),url('https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-course-divemaster-real.png')!important;background-size:cover,contain!important;background-position:center!important;background-repeat:no-repeat!important;"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-course-divemaster-real.png" alt="Divemaster" loading="eager" decoding="async"></div><div class="wd-course-body"><div class="wd-course-meta"><span>Jalur pro</span><span>Bervariasi</span></div><h3>Divemaster</h3><p>Pimpin dive, bantu kelas, dan mulai karir profesional selam.</p><a href="/courses/">Lihat Detail →</a></div></article></div>
<div class="wd-course-grid wd-hidden" id="wd-tab-tdi" style="width:100%!important;min-width:0!important;max-width:100%!important;margin:0!important;display:none!important;grid-auto-flow:row!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:22px!important;">
<article class="wd-course-card"><div class="wd-course-photo" style="background-image:linear-gradient(135deg,rgba(232,251,255,.28),rgba(255,255,255,.42)),url('https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-course-nitrox-real-v2.jpg')!important;background-size:cover,contain!important;background-position:center!important;background-repeat:no-repeat!important;"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-course-nitrox-real-v2.jpg" alt="Intro to Tech" loading="eager" decoding="async"></div><div class="wd-course-body"><div class="wd-course-meta"><span>Perkenalan</span><span>1-2 hari</span></div><h3>Intro to Tech</h3><p>Perkenalan diving teknis dan peralatan lanjutan.</p><a href="/courses/">Lihat Detail →</a></div></article><article class="wd-course-card"><div class="wd-course-photo" style="background-image:linear-gradient(135deg,rgba(232,251,255,.28),rgba(255,255,255,.42)),url('https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-course-nitrox-real-v2.jpg')!important;background-size:cover,contain!important;background-position:center!important;background-repeat:no-repeat!important;"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-course-nitrox-real-v2.jpg" alt="Nitrox Diver" loading="eager" decoding="async"></div><div class="wd-course-body"><div class="wd-course-meta"><span>Nitrox</span><span>1-2 hari</span></div><h3>Nitrox Diver</h3><p>Diving dengan udara terperkaya untuk limit tanpa dekompresi lebih lama.</p><a href="/courses/">Lihat Detail →</a></div></article><article class="wd-course-card"><div class="wd-course-photo" style="background-image:linear-gradient(135deg,rgba(232,251,255,.28),rgba(255,255,255,.42)),url('https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-course-nitrox-real-v2.jpg')!important;background-size:cover,contain!important;background-position:center!important;background-repeat:no-repeat!important;"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-course-nitrox-real-v2.jpg" alt="Advanced Nitrox Diver" loading="eager" decoding="async"></div><div class="wd-course-body"><div class="wd-course-meta"><span>Nitrox lanjut</span><span>2-3 hari</span></div><h3>Advanced Nitrox Diver</h3><p>Penggunaan nitrox tingkat lanjut untuk dive lebih dalam.</p><a href="/courses/">Lihat Detail →</a></div></article><article class="wd-course-card"><div class="wd-course-photo" style="background-image:linear-gradient(135deg,rgba(232,251,255,.28),rgba(255,255,255,.42)),url('https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-course-deep-diver-real-v2.jpg')!important;background-size:cover,contain!important;background-position:center!important;background-repeat:no-repeat!important;"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-course-deep-diver-real-v2.jpg" alt="Decompression Procedures" loading="eager" decoding="async"></div><div class="wd-course-body"><div class="wd-course-meta"><span>Dekompresi</span><span>2-3 hari</span></div><h3>Decompression Procedures</h3><p>Prosedur dekompresi aman untuk dive teknis.</p><a href="/courses/">Lihat Detail →</a></div></article></div>
<script>
function wdSwitchTab(tab) {
  document.querySelectorAll('.wd-chip[data-tab]').forEach(function(b) {
    b.classList.toggle('active', b.dataset.tab === tab);
  });
  var showEl = document.getElementById(tab === 'naui' ? 'wd-tab-naui' : 'wd-tab-tdi');
  var hideEl = document.getElementById(tab === 'naui' ? 'wd-tab-tdi' : 'wd-tab-naui');
  showEl.style.setProperty('display', 'grid', 'important');
  showEl.style.setProperty('visibility', 'visible', 'important');
  showEl.style.setProperty('height', 'auto', 'important');
  showEl.style.setProperty('position', 'static', 'important');
  showEl.style.setProperty('left', 'auto', 'important');
  hideEl.style.setProperty('display', 'none', 'important');
  hideEl.style.setProperty('visibility', 'hidden', 'important');
  hideEl.style.setProperty('height', '0', 'important');
  hideEl.style.setProperty('overflow', 'hidden', 'important');
}
</script>
<div class="wd-section-cta"><a class="wd-btn alt" href="/courses/">Lihat Semua Kursus →</a></div></div></section>

  <!-- DIVE SITES HIDDEN -->
<!-- EQUIPMENT -->
  <style>
.home .wd-eq .wd-home-equip-card{transition:transform .3s ease,box-shadow .3s ease!important}
.home .wd-eq .wd-home-equip-card:hover{transform:translateY(-6px)!important;box-shadow:0 20px 50px rgba(0,0,0,.28)!important}
.home .wd-eq .wd-home-equip-card:hover .wd-home-equip-photo img{transform:scale(1.06)!important}
.home .wd-eq .wd-sub{margin-bottom:28px!important}
</style>

  <section id="equipment" class="wd-section white wd-center wd-eq"><div class="wd-shell"><div class="wd-divider"><h2 class="wd-title">Peralatan Selam</h2></div><p class="wd-sub">Gear berkualitas untuk latihan, fun dive, dan kenyamanan bawah air yang lebih aman. Beli atau sewa melalui crew.</p><div class="wd-equipment-grid"><article class="wd-course-card wd-home-equip-card"><div class="wd-course-photo wd-home-equip-photo" style="background-image:linear-gradient(135deg,rgba(232,251,255,.28),rgba(255,255,255,.42)),url('https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-equipment-mask-real.png')!important;background-size:cover,contain!important;background-position:center!important;background-repeat:no-repeat!important;"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-equipment-mask-real.png" alt="Masker" loading="eager" decoding="async"></div><div class="wd-course-body wd-home-equip-body"><div class="wd-course-meta"><span>Masker</span><span>Peralatan</span></div><h3>Masker</h3><p>Visi jelas dan pas yang bisa diandalkan</p><a href="/equipment/">Lihat Detail</a></div></article><article class="wd-course-card wd-home-equip-card"><div class="wd-course-photo wd-home-equip-photo" style="background-image:linear-gradient(135deg,rgba(232,251,255,.28),rgba(255,255,255,.42)),url('https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-equipment-wetsuit-real.png')!important;background-size:cover,contain!important;background-position:center!important;background-repeat:no-repeat!important;"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-equipment-wetsuit-real.png" alt="Wetsuit" loading="eager" decoding="async"></div><div class="wd-course-body wd-home-equip-body"><div class="wd-course-meta"><span>Wetsuit</span><span>Peralatan</span></div><h3>Wetsuit</h3><p>Kenyamanan termal untuk dive lebih lama</p><a href="/equipment/">Lihat Detail</a></div></article><article class="wd-course-card wd-home-equip-card"><div class="wd-course-photo wd-home-equip-photo" style="background-image:linear-gradient(135deg,rgba(232,251,255,.28),rgba(255,255,255,.42)),url('https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-equipment-bcd-real.png')!important;background-size:cover,contain!important;background-position:center!important;background-repeat:no-repeat!important;"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-equipment-bcd-real.png" alt="BCD" loading="eager" decoding="async"></div><div class="wd-course-body wd-home-equip-body"><div class="wd-course-meta"><span>BCD</span><span>Peralatan</span></div><h3>BCD</h3><p>Kontrol buoyancy dan dukungan trim</p><a href="/equipment/">Lihat Detail</a></div></article><article class="wd-course-card wd-home-equip-card"><div class="wd-course-photo wd-home-equip-photo" style="background-image:linear-gradient(135deg,rgba(232,251,255,.28),rgba(255,255,255,.42)),url('https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-equipment-regulator-real.png')!important;background-size:cover,contain!important;background-position:center!important;background-repeat:no-repeat!important;"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-equipment-regulator-real.png" alt="Regulator" loading="eager" decoding="async"></div><div class="wd-course-body wd-home-equip-body"><div class="wd-course-meta"><span>Regulator</span><span>Peralatan</span></div><h3>Regulator</h3><p>Pernapasan lancar dan pengiriman udara yang aman</p><a href="/equipment/">Lihat Detail</a></div></article></div><div class="wd-section-cta"><a class="wd-btn alt" href="/equipment/">Lihat Semua Peralatan</a></div></div></section>

  <!-- SOCIAL PROOF (NEW) -->
  <section class="wd-section wd-proof wd-center"><div class="wd-shell"><span class="wd-kicker">Dipercaya Diver</span><h2 class="wd-title">Kata Komunitas Kami</h2><div class="wd-reviews-grid">
    <article class="wd-review-card"><div class="wd-review-stars">★★★★★</div><p>"Kursus open water pertamaku terasa aman dan tenang berkat crew-nya. Grup kecil, instruktur sabar, dan kondisi gear sangat bagus."</p><div class="wd-review-author"><b>Sarah M.</b><span>Open Water Diver</span></div></article>
    <article class="wd-review-card"><div class="wd-review-stars">★★★★★</div><p>"Pelatihan serius dengan crew Jakarta yang tenang. Jalur Divemaster-ku terasa terstruktur, jujur, dan fokus pada kepemimpinan dive yang nyata."</p><div class="wd-review-author"><b>Marco R.</b><span>PADI Divemaster</span></div></article>
    <article class="wd-review-card"><div class="wd-review-stars">★★★★★</div><p>"Beli masker dan fins pertamaku di sini. Crew-nya bantu cari ukuran yang pas sebelum aku masuk ke air. Pelayanan oke banget."</p><div class="wd-review-author"><b>Ayu P.</b><span>Diver Aktif</span></div></article>
  </div></div></section>

  <!-- ARTICLES -->
    <section id="articles" class="wd-section wd-articles"><div class="wd-shell"><div class="wd-article-head"><div><span class="wd-kicker">Artikel Pilihan</span><h2 class="wd-title">Cerita Dive &amp; Catatan Laut</h2><p class="wd-sub">Bacaan pilihan untuk diver baru, pembeli gear, dan anggota komunitas yang peduli laut.</p></div><a class="wd-btn" href="/blog/">Baca Blog</a></div><div class="wd-article-grid wd-article-grid-dynamic">
        <article class="wd-featured-card wd-featured-card-image" style="--wd-article-img:url('https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-course-open-water-real.png')"><span>Unggulan</span><h3>Understanding Safety Stops Without Overthinking Them</h3><p>A safety stop gives your body extra margin after a dive. Watch depth, stay neutrally buoyant, breathe calmly, and avoid popping up at the&hellip;</p><a href="https://whaledivecentre.com/understanding-safety-stops-without-overthinking-them/">Baca Artikel</a></article>
          <article class="wd-mini-article wd-mini-article-image"><a class="wd-mini-article-thumb" href="https://whaledivecentre.com/how-to-test-mask-fit-before-buying/"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-equipment-mask-real.png" alt="How to Test Mask Fit Before Buying" loading="lazy"></a><b>Gear Guide</b><h3><a href="https://whaledivecentre.com/how-to-test-mask-fit-before-buying/">How to Test Mask Fit Before Buying</a></h3><p>Place the mask on your face without using the strap, inhale gently through your nose, and check for...</p><a class="wd-article-link" href="https://whaledivecentre.com/how-to-test-mask-fit-before-buying/">Baca Artikel</a></article>
          <article class="wd-mini-article wd-mini-article-image"><a class="wd-mini-article-thumb" href="https://whaledivecentre.com/when-to-move-from-open-water-to-advanced/"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-course-rescue-diver-real.png" alt="When to Move from Open Water to Advanced" loading="lazy"></a><b>Training Tips</b><h3><a href="https://whaledivecentre.com/when-to-move-from-open-water-to-advanced/">When to Move from Open Water to Advanced</a></h3><p>Move up when buoyancy feels stable and you are ready to add task loading. Advanced training is best...</p><a class="wd-article-link" href="https://whaledivecentre.com/when-to-move-from-open-water-to-advanced/">Baca Artikel</a></article>
          <article class="wd-mini-article wd-mini-article-image"><a class="wd-mini-article-thumb" href="https://whaledivecentre.com/simple-reef-etiquette-every-diver-should-practice/"><img src="https://whaledivecentre.com/wp-content/themes/theme-travel-master/assets/wdc-course-divemaster-real.png" alt="Simple Reef Etiquette Every Diver Should Practice" loading="lazy"></a><b>Conservation</b><h3><a href="https://whaledivecentre.com/simple-reef-etiquette-every-diver-should-practice/">Simple Reef Etiquette Every Diver Should Practice</a></h3><p>Good buoyancy, no touching, careful finning, and distance from marine life are the basics. Small habits protect the...</p><a class="wd-article-link" href="https://whaledivecentre.com/simple-reef-etiquette-every-diver-should-practice/">Baca Artikel</a></article>
      </div></div></section>

