    <style>
        .wa-float-btn {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 9999;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 14px 20px;
            background: #25D366;
            color: white;
            border-radius: 50px;
            text-decoration: none;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 700;
            font-size: 15px;
            box-shadow: 0 4px 20px rgba(37,211,102,0.4);
            transition: all 0.3s ease;
            animation: wa-pulse 2s infinite;
        }
        .wa-float-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(37,211,102,0.5);
            background: #20BD5A;
            color: white;
        }
        @keyframes wa-pulse {
            0%, 100% { box-shadow: 0 4px 20px rgba(37,211,102,0.4); }
            50% { box-shadow: 0 4px 30px rgba(37,211,102,0.6); }
        }
        @media (max-width: 768px) {
            .wa-float-btn {
                bottom: 16px;
                right: 16px;
                padding: 12px 16px;
                font-size: 14px;
            }
            .wa-float-btn span {
                display: none;
            }
            .wa-float-btn {
                border-radius: 50%;
                width: 56px;
                height: 56px;
                padding: 14px;
                justify-content: center;
            }
        }
    </style>
