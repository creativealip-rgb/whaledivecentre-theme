.whaledive-home .wd-course-grid .wd-course-body p,
.whaledive-home #equipment .wd-home-equip-body p,
.whaledive-home #equipment .wd-equip-home-body p{margin:0 0 4px!important;min-height:0!important}
.whaledive-home #courses .wd-course-body a,
.whaledive-home .wd-course-grid .wd-course-body a,
.whaledive-home #equipment .wd-home-equip-body a,
.whaledive-home #equipment .wd-equip-home-body a{min-height:38px!important;min-width:128px!important;margin-top:auto!important;margin-bottom:0!important;padding:0 16px!important;justify-content:center!important;border-radius:999px!important;font-size:12px!important}

/* WDC tighten home equipment CTA spacing 2026-05-16 */
.whaledive-home #equipment .wd-section-cta{margin:28px 0 0!important;padding:0!important}
.whaledive-home #equipment{padding-bottom:64px!important}
@media(max-width:760px){.whaledive-home .wd-course-grid,.whaledive-home .wd-equipment-grid{grid-template-columns:1fr!important;width:100%!important;max-width:100%!important;gap:14px!important}.whaledive-home .wd-course-grid .wd-course-card,.whaledive-home .wd-equipment-grid .wd-home-equip-card{width:100%!important;max-width:100%!important;min-width:0!important}.whaledive-home .wd-course-grid .wd-course-body a,.whaledive-home #courses .wd-course-body a{width:auto!important;max-width:100%!important;white-space:normal!important;box-sizing:border-box!important;align-self:flex-start!important}.whaledive-home #equipment .wd-home-equip-photo img{transform:none!important;max-width:100%!important}}

