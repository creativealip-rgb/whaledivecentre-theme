                    <a href="<?php echo esc_url($course['href']); ?>" style="display:inline-flex;align-items:center;justify-content:center;padding:10px 16px;border-radius:999px;background:#f3fbff;color:#06384d;text-decoration:none;font-weight:900;font-size:13px;border:1px solid rgba(6,56,77,.12);"><?php echo esc_html(contenly_tr('Detail', 'Details')); ?></a>
                </div>
