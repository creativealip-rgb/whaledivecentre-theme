        <h2 style="font-size:20px;font-weight:800;color:#0f172a;margin:0 0 16px;letter-spacing:.03em;"><?php echo esc_html(contenly_tr('Jalur Kursus Tersedia', 'Available Course Pathways')); ?></h2>
